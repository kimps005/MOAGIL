{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "web",
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{apk/**,backend/data/**,backend/tests/**,demo/**,docs/**,vehicle-app/**,**/__pycache__/**,**/*.pyc}"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/landing.html" },
    { "source": "/api", "destination": "/api/index?__moagil_path=/api" },
    { "source": "/api/:path*", "destination": "/api/index?__moagil_path=/api/:path*" },
    { "source": "/app", "destination": "/index.html" },
    { "source": "/app/:path*", "destination": "/index.html" },
    { "source": "/join", "destination": "/index.html" },
    { "source": "/join/:path*", "destination": "/index.html" }
  ]
}
