# No secrets are needed for the P0 mock prototype.
HOST=0.0.0.0
PORT=8080
# Optional: QR host override when the vehicle uses a different API host (e.g. Android emulator).
# Set to a LAN address reachable from the passenger's phone; never use localhost here.
# MOAGIL_PUBLIC_BASE_URL=http://192.168.0.10:8080
# Optional: choose a local SQLite file outside the repository.
# MOAGIL_DB=C:\\path\\to\\moagil.db
# Naver Maps Client ID from an NCP Maps application; used for browser and Android maps.
MOAGIL_NAVER_CLIENT_ID=
# Only needed to opt in to Naver Directions for server-side route scoring.
# The Client Secret stays on this server and is never sent to the browser or APK.
MOAGIL_NAVER_CLIENT_SECRET=
# Optional route scorer: osrm (default), naver, or mock. Map display does not select the route scorer.
# MOAGIL_ROUTING_PROVIDER=naver
