# Local MOAGIL server configuration. Keep credentials in this untracked .env file.
HOST=0.0.0.0
PORT=8080
# Optional: QR host override when the vehicle uses a different API host (e.g. Android emulator).
# Set to a LAN address reachable from the passenger's phone; never use localhost here.
# MOAGIL_PUBLIC_BASE_URL=http://192.168.0.10:8080
# Optional: choose a local SQLite file outside the repository.
# MOAGIL_DB=C:\\path\\to\\moagil.db
# Hosted Vercel deployment: set the Supabase PostgreSQL connection string as
# MOAGIL_DATABASE_URL in Vercel's server-side environment variables. Do not put
# the connection string in web code or commit it here.
# MOAGIL_DATABASE_URL=postgresql://...
# Optional: use the stable production project URL in QR invitations.
# MOAGIL_PUBLIC_BASE_URL=https://your-project.vercel.app
# Kakao REST API key for Kakao Local search and Kakao Mobility live Directions.
# Keep this key on the server; do not put it in browser or Android configuration.
MOAGIL_KAKAO_REST_API_KEY=
# Required Kakao Maps JavaScript key for the web and vehicle map screens; there is no map fallback.
# Register every exact web origin used by the app as a JavaScript SDK domain in Kakao Developers.
MOAGIL_KAKAO_JAVASCRIPT_KEY=
# Kakao live travel times are stored with the selected plan; Kakao API quotas apply.
